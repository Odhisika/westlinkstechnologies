# Copy to .env.local and fill in.
# Because this site is statically exported, NEXT_PUBLIC_* values are baked into
# the build. Set them before running `npm run build`.

# The production URL used for metadata, canonical URLs, sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=https://westlinkstechnologies.com

# General inquiry address shown in the UI and used for mailto fallbacks.
NEXT_PUBLIC_CONTACT_EMAIL=westlinkstechnologies@gmail.com

# Phone number shown in the UI, in international format.
NEXT_PUBLIC_CONTACT_PHONE=+233593021696

# Where the contact form POSTs (e.g. Formspree, Resend form, or your webhook).
# If empty, the form opens a prefilled email instead.
NEXT_PUBLIC_CONTACT_ENDPOINT=

# Where the newsletter form POSTs. If empty, a mailto request link is shown.
NEXT_PUBLIC_NEWSLETTER_ENDPOINT=

# Optional: Cal.com / Calendly booking link shown on the contact page.
NEXT_PUBLIC_BOOKING_URL=

# Optional: social links. When empty, social icons are hidden rather than dead.
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_LINKEDIN_URL=

# Optional: Crisp live chat (get the ID from your Crisp settings).
NEXT_PUBLIC_CRISP_WEBSITE_ID=
